<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>grippers_vla</name>
  <version>0.0.0</version>
  <description>SmolVLA 정책을 텔레옵 팔로워에 물리는 노드 (스트레치)</description>
  <maintainer email="11306260+liangfuyuan@user.noreply.gitee.com">ubuntu</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>grippers_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <!-- lerobot / torch 는 rosdep 에 없다. 컨테이너에 pip 로 넣는다 —
       tools/vla/README.md 참고. 여기 적으면 rosdep install 이 실패한다. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
